{
  "rules": {
    "private": {
      ".read": false,
      ".write": false
    },
    "tokens": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'superadmin')"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.role === 'superadmin' || auth.token.role === 'admin')",
      "passwordChanged": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'superadmin')"
        }
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'superadmin')",
      ".indexOn": ["to", "from"],
      "$msgId": {
        ".write": "auth != null && (!data.exists() && (newData.child('from').val() === auth.uid || auth.token.role === 'admin' || auth.token.role === 'superadmin') || data.exists() && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid || auth.token.role === 'admin' || auth.token.role === 'superadmin'))"
      }
    },
    "voice": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'superadmin')",
      "$msgId": {
        ".write": "auth != null"
      }
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'superadmin')",
      ".indexOn": ["to", "from", "time"],
      "$histId": {
        ".write": "auth != null"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'superadmin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'superadmin')"
      }
    },
    "usageLogs": {
      ".read": "auth != null",
      "$dateKey": {
        "$userId": {
          ".write": "auth != null"
        }
      },
      ".write": "auth != null && auth.token.role === 'superadmin'"
    }
  }
}
